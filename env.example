# Copy to .env for local builds. Never commit .env — it's gitignored.
# In Cloudflare these live in Settings > Variables and secrets instead.

GCC_CLIENT_ID=your-id.apps.googleusercontent.com
GCC_ENDPOINT=https://script.google.com/macros/s/AKfyc.../exec

# Optional
GCC_DOMAIN=gsfcuniversity.ac.in
GCC_DEADLINE=15 Aug 2026

# Set to 1 to post through functions/api/submit.js instead of straight to Apps Script
GCC_USE_PROXY=0
